# ===========================================================================
# Frontend Environment Template (Next.js 16 + Supabase)
# ===========================================================================

# 1. Supabase Project URL (Found in: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Anonymous API Key (Found in: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Python ML Inference Service URL (Used by Next.js rewrites)
# In local development: http://localhost:8008
# In production: https://digit-classification-ml-api.onrender.com
ML_SERVICE_URL=http://localhost:8008
